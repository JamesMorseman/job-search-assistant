# ── USAJOBS ──────────────────────────────────────────────────────────────────
# Free instant-approval: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_EMAIL=your_email@example.com

# ── Adzuna ───────────────────────────────────────────────────────────────────
# Free tier: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# ── Google (Sheets / Drive / Gmail) ──────────────────────────────────────────
# OAuth2 desktop flow — download credentials.json from Google Cloud Console
# Scopes needed: sheets, drive, gmail.readonly
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# ── Google Sheets tracker ─────────────────────────────────────────────────────
# Create a new Sheet, paste its ID here
TRACKER_SHEET_ID=your_google_sheet_id_here

# ── Google Drive folder ───────────────────────────────────────────────────────
# Parent folder in Drive where per-application subfolders will be created
DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here

# ── Gmail label for job alerts ────────────────────────────────────────────────
# Label name in Gmail that job alert emails are filed under
GMAIL_ALERT_LABEL=job-alerts

# ── LLM providers (generation, grading, profile/extraction) ────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4.1

GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-4.1

GRADING_PROVIDER=openai
GRADING_MODEL=gpt-4.1

PROFILE_PROVIDER=openai
PROFILE_MODEL=gpt-4.1

EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-4.1

# ── Local DB ──────────────────────────────────────────────────────────────────
DB_PATH=data/jobs.db

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DRY_RUN=false
